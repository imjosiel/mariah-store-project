# Auth.js (NextAuth v5)
# Gere com: npx auth secret
AUTH_SECRET=

# Credenciais do cliente OAuth no Google Cloud
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Fotos no Cloudflare R2 (fora do repositório). Cota padrão 1 GB, ajustável no admin.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_URL=https://<dominio-publico-ou-r2.dev>/

# Banco Neon (Neon + Prisma).
# DATABASE_URL = host COM "-pooler" (pgbouncer); DIRECT_URL = host SEM "-pooler" (migrations).
DATABASE_URL=postgresql://usuario:senha@host-pooler/neondb?sslmode=require&channel_binding=require
DIRECT_URL=postgresql://usuario:senha@host/neondb?sslmode=require&channel_binding=require

# Dados cadastrais exibidos em /politicas (Decreto 7.962/2013).
# Preencha antes de vender — a loja é pessoa física e ainda não tem CNPJ.
NEXT_PUBLIC_STORE_LEGAL_NAME=
NEXT_PUBLIC_STORE_CNPJ=
NEXT_PUBLIC_STORE_ADDRESS=
NEXT_PUBLIC_STORE_EMAIL=
NEXT_PUBLIC_STORE_PHONE=
NEXT_PUBLIC_STORE_WHATSAPP=

# Não há mais SUPER_ADMIN_EMAIL / ADMIN_EMAILS: a primeira conta Google que
# entrar no /admin vira super administrador e passa a gerenciar a lista no banco.
